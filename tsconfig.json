{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "allowJs": true,
    "declaration": true,
    "strict": true,
    "isolatedModules": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "pdfjs-lib": ["./src/pdf"],
      "display-binary_data_factory": ["./src/display/binary_data_factory"],
      "display-network_stream": ["./src/display/network_stream"],
      "display-node_utils": ["./src/display/node_utils"],
      "fluent-bundle": ["./node_modules/@fluent/bundle/esm/index.js"],
      "fluent-dom": ["./node_modules/@fluent/dom/esm/index.js"],
      "web-null_l10n": ["./web/genericl10n"]
    }
  },
  "files": [
    "src/pdf.ts",
    "src/types/globals.d.ts",
    "web/pdf_viewer.component.ts"
  ],
  "include": ["src/types/**/*.d.ts"]
}
